# ── Base de datos ──────────────────────────────────────────────
DATABASE_URL="postgresql://munia:munia@localhost:5432/munia_fomento?schema=public"

# ── Servidor ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Origen del frontend para CORS
WEB_ORIGIN="http://localhost:5173"
# Secreto de firma de sesión (cookie). Generar uno fuerte en prod.
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# ── Tenant por defecto (despliegue mono-municipio) ─────────────
# El municipio es CONFIGURACIÓN, no código. Slug del tenant que sirve la raíz.
DEFAULT_TENANT_SLUG="demo"

# ── Autenticación ──────────────────────────────────────────────
# Estrategia principal: "clave_unica" | "password" (fallback dev)
AUTH_PRIMARY_STRATEGY="password"
# ClaveÚnica (OIDC) — sólo necesario si AUTH_PRIMARY_STRATEGY=clave_unica
CLAVEUNICA_CLIENT_ID=""
CLAVEUNICA_CLIENT_SECRET=""
CLAVEUNICA_REDIRECT_URI="http://localhost:4000/api/auth/clave-unica/callback"
CLAVEUNICA_AUTH_URL="https://accounts.claveunica.gob.cl/openid/authorize"
CLAVEUNICA_TOKEN_URL="https://accounts.claveunica.gob.cl/openid/token"
CLAVEUNICA_USERINFO_URL="https://www.claveunica.gob.cl/openid/userinfo"

# ── Email transaccional ────────────────────────────────────────
# Proveedor: "console" (dev, imprime a stdout) | "resend"
EMAIL_PROVIDER="console"
EMAIL_FROM="MunIA Fomento <no-reply@example.cl>"
RESEND_API_KEY=""

# ── Almacenamiento de archivos ─────────────────────────────────
# Proveedor: "local" (dev, ./uploads) | "s3"
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ── Asistente IA de Fondos (RAG de MunIA core) ─────────────────
# Proveedor de match: "mock" (dev, motor por intención) | "rag"
FONDOS_MATCH_PROVIDER="mock"
RAG_ENDPOINT=""
RAG_API_KEY=""
